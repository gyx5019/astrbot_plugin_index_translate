{
  "target_lang": {
    "type": "string",
    "description": "默认目标语言",
    "default": "en",
    "options": [
      "zh",
      "en",
      "ja",
      "ko",
      "fr",
      "de",
      "es",
      "pt",
      "ru",
      "it",
      "ar",
      "hi",
      "vi",
      "th",
      "id",
      "ms",
      "fil",
      "tr",
      "nl",
      "pl",
      "sv",
      "ukr_cyrl",
      "fas_arab",
      "ces_latn",
      "ell_grek"
    ],
    "hint": "中文=zh，英语=en，日语=ja……也可以在指令里临时指定，如「翻译成日语 xxx」"
  },
  "model": {
    "type": "string",
    "description": "模型",
    "default": "Index-Translate-35B-A3B",
    "options": [
      "Index-Translate-35B-A3B",
      "Index-Translate-9B",
      "Index-Translate-2B"
    ],
    "hint": "35B-A3B 是旗舰，效果最好；9B 均衡；2B 最快最省"
  },
  "max_tokens": {
    "type": "int",
    "description": "单次生成的最大 token 数",
    "default": 1024
  },
  "chunk_chars": {
    "type": "int",
    "description": "长文本分段长度（字符）",
    "default": 900,
    "hint": "超过这个长度会按段落切片逐段翻译再拼起来，0 表示不分段"
  },
  "timeout": {
    "type": "int",
    "description": "单次请求超时（秒）",
    "default": 90
  },
  "api_base": {
    "type": "string",
    "description": "API 地址",
    "default": "https://index-translate.bilibili.com/v1"
  },
  "show_usage": {
    "type": "bool",
    "description": "翻译结果末尾附上耗时和 token 用量",
    "default": false
  },
  "image_render": {
    "type": "bool",
    "description": "图片翻译输出「回填译文的图」（需要填 OCR 接口地址）",
    "default": false,
    "hint": "关闭时图片翻译只输出文字；开启且 ocr_api_base 可用时，会调用 OCR 拿到文字位置，把原文擦掉写上译文，发回一张译好的图"
  },
  "ocr_provider": {
    "type": "string",
    "description": "OCR 用哪家",
    "default": "cnocr",
    "options": [
      "cnocr",
      "glm"
    ],
    "hint": "cnocr：自己起 CnOCR 的 FastAPI（cnocr serve -p 8501）；glm：智谱 GLM-OCR（需 API Key，返回坐标可回填）"
  },
  "ocr_api_base": {
    "type": "string",
    "description": "OCR 服务地址",
    "default": "",
    "hint": "cnocr 例：http://127.0.0.1:8501；glm 留空用 https://open.bigmodel.cn/api/paas/v4"
  },
  "ocr_api_key": {
    "type": "string",
    "description": "OCR 服务的 API Key（选 glm 时填）",
    "default": "",
    "hint": "选 glm 时填智谱的 key；cnocr 自建服务不用填"
  },
  "ocr_api_path": {
    "type": "string",
    "description": "cnocr 的接口路径",
    "default": "/ocr"
  },
  "ocr_timeout": {
    "type": "int",
    "description": "OCR 请求超时（秒）",
    "default": 60
  },
  "render_font": {
    "type": "string",
    "description": "回填时用的字体文件",
    "default": "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc"
  }
}